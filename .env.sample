# Copy to .env (git-ignored). Used by scripts/expl-bot-run.ts (Flow 2: expl-bot-independent-*).

# App to explore (the URL argument of `npm run expl-bot:run -- <url>` wins over this).
EXPL_BOT_URL=http://localhost:3000/

# Optional free-form login text for headless runs, kept in memory only (never written to files), e.g.:
#   EXPL_BOT_AUTH=login: qa@example.com password: secret
# Alternative without secrets in .env: log in once in Flow 1 and answer "yes" to saving the login state
# (.workflow-artifacts/expl-bot/sites/<host>/auth.json).
EXPL_BOT_AUTH=

# Hard cap on agent turns for one run.
MAX_PIPELINE_TURNS=300

# Authentication for the Claude Agent SDK. Pick one, or leave both empty to use the local Claude Code login.
#   ANTHROPIC_API_KEY=sk-ant-...            (pay-per-token API)
#   CLAUDE_CODE_OAUTH_TOKEN=...             (from `claude setup-token`; check Anthropic's current terms for
#                                            using a subscription in automation before relying on this)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
